# Unity .gitattributes — normalize line endings and mark binary files

# Auto-detect text files and normalize line endings to LF in the repo
* text=auto

# Unity YAML files — force LF, mark as mergeable text
*.unity text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.brush text eol=lf
*.flare text eol=lf
*.fontsettings text eol=lf
*.giparams text eol=lf
*.guiskin text eol=lf
*.lightingdata.asset binary
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.preset text eol=lf
*.renderTexture text eol=lf
*.shadervariants text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.mixer text eol=lf
*.signal text eol=lf

# Source code — force LF
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf

# Config / data
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf

# Binary files — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.fbx binary
*.obj binary
*.blend binary
*.dae binary
*.3ds binary
*.max binary
*.ma binary
*.mb binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.a binary
*.unitypackage binary
*.wlt binary
